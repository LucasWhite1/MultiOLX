{
  "name": "multiolx-browser",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Navegador desktop com sessões isoladas e chats unificados da OLX.",
  "scripts": {
    "setup": "node node_modules/electron/install.js",
    "start": "electron browser/main.cjs",
    "browser": "electron browser/main.cjs",
    "test:browser": "node scripts/browser-self-test.mjs",
    "test": "vitest run",
    "check": "node scripts/check.mjs && tsc --noEmit",
    "credentials": "node scripts/generate-credentials.mjs",
    "test:web": "node scripts/web-self-test.mjs",
    "test:docker": "node scripts/docker-self-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "electron": "^44.7.2",
    "web-push": "^3.6.7"
  }
}
